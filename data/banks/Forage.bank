patch Tight family=shape
  # Everything short. A decay of 0.35 is about a tenth of a second, so each
  # pad is its attack and very little else - the difference between a kit you
  # can play sixteenths on and one that smears.
  p*_decay       0.35
  volume         0.2893
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  set macro2 "Short"
  mac2_d1  #3
  mac2_a1  -0.6
  mac2_d2  #12
  mac2_a2  0.1094
  set macro3 "Dark"
  mac3_d1  #5
  mac3_a1  -0.3
  mac3_d2  #12
  mac3_a2  0.0233
  set macro4 "Crush"
  mac4_d1  #7
  mac4_a1  0.5
  mac4_d2  #12
  mac4_a2  0.02
  set macro5 "Cut"
  mac5_d1  #2
  mac5_a1  -0.25
  set macro6 "Punch"
  mac6_d1  #8
  mac6_a1  0.3
  mac6_d2  #9
  mac6_a2  -0.3
  mac6_d3  #12
  mac6_a3  0.0233
  set macro7 "Kick"
  mac7_d1  #27
  mac7_a1  0.1
  mac7_d2  #14
  mac7_a2  -0.04
  set macro8 "Snare"
  mac8_d1  #29
  mac8_a1  0.1
  mac8_d2  #30
  mac8_a2  0.1
  mac8_d3  #12
  mac8_a3  -0.0214

patch Gated family=shape
  # Shorter still, and hard. This is the gate on a room mic: the front of
  # every sample and then nothing, which turns any kit into a tight one
  # whether or not it was recorded that way.
  p*_decay       0.2
  accent         0.85
  volume         0.306
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  set macro2 "Short"
