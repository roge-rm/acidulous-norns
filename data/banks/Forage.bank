patch Spread family=kit
  # The kit across the image rather than in a heap. Kick, snare and clap stay
  # where they belong - in the middle, because that is where the weight goes -
  # and everything that decorates is placed around them, toms left to right as
  # a drummer sits behind them.
  #
  # It is narrower than it first was, and the cymbals have swapped sides. At
  # plus and minus seven tenths the patch swung twelve decibels between the
  # channels - which is not an image, it is a kit that has fallen over - and
  # the sides were wrong as well: crash, low tom and clave were all left, so
  # everything with weight in it leaned one way.
  p01_pan        -0.3
  p04_pan        -0.42
  p05_pan        -0.14
  p06_pan        0.2
  p07_pan        0.28
  p08_pan        0.34
  p09_pan        0.45
  p10_pan        -0.45
  p11_pan        0.24
  p12_pan        -0.26
  accent         0.7
  volume         0.1922
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  mac1_d2  #12
  mac1_a2  -0.00613
  set macro2 "Short"
  mac2_d1  #3
  mac2_a1  -0.6
  mac2_d2  #12
  mac2_a2  0.1016
  set macro3 "Dark"
  mac3_d1  #5
  mac3_a1  -0.3
  mac3_d2  #12
  mac3_a2  0.0469
  set macro4 "Crush"
  mac4_d1  #7
  mac4_a1  0.5
  mac4_d2  #12
  mac4_a2  0.0133
  set macro5 "Kick"
  mac5_d1  #27
  mac5_a1  0.1
  mac5_d2  #14
  mac5_a2  -0.04
  set macro6 "Snare"
  mac6_d1  #29
  mac6_a1  0.1
  mac6_d2  #30
  mac6_a2  0.1
  set macro7 "Toms"
  mac7_d1  #18
  mac7_a1  -0.1
  mac7_d2  #19
  mac7_a2  -0.1
  mac7_d3  #20
  mac7_a3  -0.1
  set macro8 "Hats"
  mac8_d1  #34
  mac8_a1  0.08
  mac8_d2  #35
  mac8_a2  0.08

patch "Low and High" family=kit
  # Split the kit by what it is for: everything below the hats keeps its
  # weight, everything above is thinned and shortened so it sits on top
  # instead of competing. A mix decision stored as a patch.
  p00_cutoff     9000 Hz
  p01_cutoff     9000 Hz
  p02_cutoff     12000 Hz
  p03_cutoff     12000 Hz
  p04_cutoff     7000 Hz
  p05_cutoff     7000 Hz
  p06_cutoff     7000 Hz
  p07_decay      0.5
  p08_decay      0.6
  p09_decay      0.7
  p10_decay      0.65
