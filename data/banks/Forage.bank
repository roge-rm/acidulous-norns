  mac6_d1  #8
  mac6_a1  0.3
  mac6_d2  #9
  mac6_a2  -0.3
  set macro7 "Kick"
  mac7_d1  #27
  mac7_a1  0.1
  mac7_d2  #14
  mac7_a2  -0.04
  mac7_d3  #12
  mac7_a3  -0.0195
  set macro8 "Snare"
