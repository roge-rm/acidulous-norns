  mac8_d2  #30
  mac8_a2  0.1

patch Clipped family=shape
  # The front third of each sample and no more, cut by the end point rather
  # than by an envelope - so it stops dead instead of fading. On a long
  # sample this is the transient alone; on a short one it changes nothing,
  # which is the honest behaviour.
  p*_end         0.33
  volume         0.2115
  set macro1 "Lower"
  mac1_d1  #10
  mac1_a1  -0.25
  set macro2 "Short"
  mac2_d1  #3
  mac2_a1  -0.6
  mac2_d2  #4
  mac2_a2  0.031
  mac2_d3  #12
  mac2_a3  0.0781
  set macro3 "Dark"
  mac3_d1  #5
  mac3_a1  -0.3
  mac3_d2  #12
  mac3_a2  0.0742
  set macro4 "Crush"
  mac4_d1  #7
  mac4_a1  0.5
  mac4_d2  #12
  mac4_a2  0.0146
  set macro5 "Cut"
  mac5_d1  #2
  mac5_a1  -0.25
  mac5_d2  #12
  mac5_a2  0.0781
  set macro6 "Punch"
  mac6_d1  #8
  mac6_a1  0.3
  mac6_d2  #9
  mac6_a2  -0.3
  mac6_d3  #12
  mac6_a3  0.0121
  set macro7 "Kick"
  mac7_d1  #27
  mac7_a1  0.1
  mac7_d2  #14
  mac7_a2  -0.04
  set macro8 "Snare"
  mac8_d1  #29
  mac8_a1  0.1
  mac8_d2  #30
  mac8_a2  0.1

patch Body family=shape
  # The opposite: the first tenth skipped, so what is left is the body without
  # the stick. Under a kit that already has attacks in it, this is the layer
  # that adds weight and nothing else.
  p*_start       0.1
  p*_decay       0.8
