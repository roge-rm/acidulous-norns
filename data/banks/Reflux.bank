  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #16
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A triangle on the pulse width over two bars: the square narrows and
  # widens slowly under the filter.
  wave           #1
