  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #13
  mac3_a1  0.25
  mac4_d1  #14
  mac4_a1  0.3
  mac5_d1  #7
  mac5_a1  0.4
  mac6_d1  #10
  mac6_a1  0.3
  mac7_d1  #11
  mac7_a1  1
  mac8_d1  #6
  mac8_a1  0.3
  # A random step on the cutoff every sixteenth, running free.
  cutoff         350 Hz
