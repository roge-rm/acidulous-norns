# Reflux - the acid bass machine. 96 patches in eight families, each from
# plainest to strangest.
#
# classic is the filter and its envelope on their own, short is plucks and
# stabs, sub puts the octave below under the line, dirty adds drive and
# inserts, motion is long slides and slow sweeps, wobble is the LFO, band is
# the band-pass mode and filter is the 12 dB lowpass, the highpass and the
# notch.
#
# Every patch but Init has eight named macros. Each one adds its depth to up
# to four destinations, so with the macros at zero a patch plays as written.
#
# Levelled to about -27.7 dB on the harness's loudness column. Band Squelch
# and Ghost sit two decibels under with their volume at the top: the band
# takes both ends off the spectrum, and drive doesn't buy it back.
#
# The band in band mode doesn't follow the keyboard, so below some note it
# sits many harmonics above the fundamental and there is no note left in it.
# Reed, Glass and the newer band patches start their range where the band
# still reaches the note. Sub Drop stops at note 45, where the sub has
# nothing left to be an octave below.
#
# Every patch says the notes it is played in, and the app puts the keyboard
# there when it is loaded. Values are in each parameter's own units;
# `audition params Reflux` lists them. A patch names only what it changes.

machine Reflux
# Sixteenths with rests, slides and accents, because what this machine is
# for happens between the notes rather than on them. Eighths showed that a
# bass machine worked and showed nothing about this one.
role    acid

# --- classic -----------------------------------------------------------

patch Init family=classic

patch Round family=classic  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.5
  mac2_d2  #3
  mac2_a2  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # No resonance at all and no envelope: the note, warm, with the filter just
  # taking the top off. Every bank needs the one that is simply a bass, and
  # a bank of nothing but acid does not have it.
  cutoff         520 Hz
  resonance      0.0
  envmod         0.0
  decay          300 ms
  accent         0.35
  slide          45 ms
  drive          0.05
  volume         0.99

patch "Open Saw" family=classic  note=36 range=24..55
  set macro1 "Close"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  -0.4
  mac2_d1  #2
  mac2_a1  0.5
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # The filter out of the way, so you can hear what it is doing to
  # everything else in the bank. Raw oscillator, drive off, and the only
  # thing shaping the note is its own decay.
  cutoff         9000 Hz
  resonance      0.05
  envmod         0.0
  decay          500 ms
  accent         0.3
  drive          0.0
  volume         0.87

patch "Warm Acid" family=classic  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A gentle acid line: some resonance, half the envelope, nothing sharp.
  cutoff         450 Hz
  resonance      0.5
  envmod         0.5
  decay          320 ms
  accent         0.6
  slide          60 ms
  drive          0.1
  volume         0.89

patch Classic family=classic  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.6
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # The one everybody means. Open enough to hear the note, resonant enough to
  # hear the filter, and a decay that shuts before the next eighth.
  #
  # Further from the machine's own defaults than it first was: at 520 Hz and
  # 0.62 it measured the same as Init, and a bank whose first two entries are
  # the same sound has nine patches in it, not ten.
  cutoff         410 Hz
  resonance      0.72
  envmod         0.64
  decay          280 ms
  accent         0.75
  slide          50 ms
  drive          0.16
  volume         0.88

patch "Square Acid" family=classic  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # The classic line on the square wave: hollower, with the same squelch.
  wave           #1
  pw             0.5
  cutoff         380 Hz
  resonance      0.75
  envmod         0.65
  decay          240 ms
  accent         0.75
  slide          55 ms
  drive          0.15
  volume         0.67

patch "Deep Acid" family=classic  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Lower and longer, with a little sub under it, for the bottom of a track.
  cutoff         220 Hz
  resonance      0.78
  envmod         0.75
  decay          420 ms
  accent         0.7
  slide          70 ms
  sub            0.15
  drive          0.15
  volume         0.9

patch Rolling family=classic  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A shorter decay and a hard accent, so a line of sixteenths rolls.
  cutoff         350 Hz
  resonance      0.7
  envmod         0.7
  decay          200 ms
  accent         0.85
  slide          80 ms
  drive          0.2
  volume         0.89

patch "Half Square" family=classic  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Saw and square half and half, a thicker note under the same filter.
  mix            0.5
  cutoff         400 Hz
  resonance      0.72
  envmod         0.65
  decay          260 ms
  accent         0.75
  slide          55 ms
  drive          0.15
  volume         1.23

patch "Soft Slope" family=classic  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # The 12 dB lowpass: more of the saw comes through, so it's brighter and
  # buzzier under the resonance.
  filter         #1
  cutoff         300 Hz
  resonance      0.8
  envmod         0.7
  decay          260 ms
  accent         0.75
  slide          50 ms
  drive          0.15
  volume         0.88

patch "Bright Acid" family=classic  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Opened up and screaming on the accents, for a line on top of the mix.
  cutoff         750 Hz
  resonance      0.82
  envmod         0.5
  decay          220 ms
  accent         0.8
  slide          45 ms
  drive          0.2
  volume         0.89

patch Squelch family=classic  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.1
  mac2_d2  #3
  mac2_a2  0.15
  mac3_d1  #4
  mac3_a1  -0.25
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.6
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Further into the resonance and a much faster decay: the blip rather than
  # the sweep. Accent nearly all the way up, because on a line like this the
  # accented steps are the line.
  cutoff         330 Hz
  resonance      0.9
  envmod         0.85
  decay          130 ms
  accent         0.92
  slide          40 ms
  drive          0.22
  volume         0.90

patch "Hard Acid" family=classic  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Full accent and a distortion after it, the line pushed hard.
  cutoff         360 Hz
  resonance      0.85
  envmod         0.8
  decay          180 ms
  accent         1
  slide          50 ms
  drive          0.45
  volume         0.75
  insert Distortion
    drive        3
    tone         5000 Hz
    mix          0.5

patch "Acid Echo" family=classic  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # The classic line into a dotted eighth delay and a little room.
  cutoff         400 Hz
  resonance      0.75
  envmod         0.65
  decay          250 ms
  accent         0.75
  slide          50 ms
  drive          0.18
  volume         0.82
  insert Delay
    time         #3
    feedback     0.35
    tone         3500 Hz
    mode         #1
    mix          0.25
  send reverb    0.1

patch Rubber family=classic  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A pulse instead of a saw, wide slide, and enough drive to round the peak
  # off. The one that bends between notes rather than stepping.
  wave           #1
  pw             0.42
  cutoff         295 Hz
  resonance      0.75
  envmod         0.7
  decay          150 ms
  accent         0.8
  slide          130 ms
  drive          0.25
  volume         0.74

# A fixed band on a moving note: below the tenor register the band sits
# thirty-five harmonics above the fundamental and there is no note left in
# it, so the range starts where the band can still reach.
patch Reed family=classic  note=48 range=36..67
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # The pulse at the far end from Hollow Pulse - nearly all the way open,
  # which is the same waveform inverted and sounds nothing like it once the
  # band-pass has taken the ends off. Thin, reedy, and the closest this
  # machine comes to being blown rather than plucked.
  wave           #1
  pw             0.9
  mode           #1
  cutoff         520 Hz
  resonance      0.7
  envmod         0.5
  decay          380 ms
  accent         0.55
  slide          90 ms
  drive          0.25
  volume         1.41

# --- short -------------------------------------------------------------

patch Pluck family=short  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Length"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  0.3
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # No resonance, a very short decay and a little drive: the filter closes
  # before it can ring, so what is left is the attack and a short woody body.
  # Round's opposite, and the only thing here that does not sound like a
  # filter at all.
  cutoff         1500 Hz
  resonance      0.05
  envmod         0.55
  decay          110 ms
  accent         0.5
  slide          30 ms
  drive          0.3
  volume         0.95

patch Thump family=short  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Length"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  0.3
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A low thud with a little sub, no resonance to speak of.
  cutoff         160 Hz
  resonance      0.2
  envmod         0.6
  decay          70 ms
  accent         0.7
  slide          20 ms
  sub            0.3
  drive          0.2
  volume         1.12

patch Damped family=short  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Length"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  0.3
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # The 12 dB lowpass and a very short decay, like a muted string.
  filter         #1
  cutoff         260 Hz
  resonance      0.3
  envmod         0.5
  decay          60 ms
  accent         0.6
  slide          20 ms
  drive          0.1
  volume         0.92

patch Doorstop family=short  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Length"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
