  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # The band with long slides and the resonance high: each note drags into
  # the next through the band.
  mode           #1
  cutoff         480 Hz
  resonance      0.8
  envmod         0.55
  decay          300 ms
  accent         0.7
  slide          220 ms
  drive          0.3
