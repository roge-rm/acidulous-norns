patch "Band Lead" family=band  note=48 range=36..67
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Band-pass with the resonance near the top, played an octave up. The
  # machine does leave the bass register, and this is what it sounds like
  # when it does: a thin reedy lead with the filter as its tone.
  mode           #1
  cutoff         1150 Hz
  resonance      0.93
  envmod         0.45
  decay          200 ms
  accent         0.6
  slide          90 ms
  drive          0.35
  volume         1.26

patch "Phone Line" family=band  note=60 range=55..79
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A wide band around a kilohertz with both waves and some grit, as if it
  # came down a phone line.
  mode           #1
  mix            0.5
  cutoff         1000 Hz
  resonance      0.4
  envmod         0.15
  decay          600 ms
  accent         0.5
  slide          50 ms
  drive          0.45
  volume         1.35
  insert Distortion
    drive        3
    tone         3500 Hz
    mix          0.4
    mode         #3
    gain         3 dB

patch Ghost family=band  note=48 range=36..67
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Air"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.3
  mac4_d2  #2
  mac4_a2  0.2
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Band-pass with the resonance low and the decay long: no bottom, no top
  # and no bite, so what is left is a breathy middle that sits under a track
  # rather than on it. The machine as a texture rather than a line.
  mode           #1
  # The band sits on the note rather than three octaves above it: at 900 Hz
  # a bass note's fundamental is nowhere near the pass band and the patch was
  # ten decibels under the bank instead of five.
  cutoff         380 Hz
  resonance      0.5
  envmod         0.25
  decay          1400 ms
  accent         0.3
  slide          180 ms
  drive          0.1
  volume         1.50

patch Vowel family=band  note=48 range=43..67
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Rate"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Depth"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
