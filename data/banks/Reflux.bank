  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  0.3
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Shut. Almost no cutoff, almost all envelope, and a decay short enough
  # that each note is a thud with a pitch somewhere inside it.
  cutoff         90 Hz
  resonance      0.55
  envmod         1
  decay          90 ms
  accent         0.85
  slide          25 ms
  drive          0.3
  volume         0.98

