patch Wide family=band  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Acid"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Body"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.5
  mac2_d2  #3
  mac2_a2  0.4
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  -0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A square and the sub together with the filter well out of the way: no
  # acid in it at all, just a large simple bass with two octaves in it. The
  # one to reach for when the line is not the point.
  wave           #1
  pw             0.5
  sub            1
  cutoff         900 Hz
  resonance      0.15
  envmod         0.1
  decay          700 ms
  accent         0.4
  slide          50 ms
  drive          0.06
  volume         1.02

