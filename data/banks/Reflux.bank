  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A slow decay on a high resonance, with the accent doing most of the
  # work: the accented notes say wah.
  cutoff         260 Hz
  resonance      0.85
  envmod         0.8
  decay          520 ms
  accent         1
  slide          60 ms
  drive          0.15
  volume         0.84

patch "Slide Line" family=motion  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Sub"
