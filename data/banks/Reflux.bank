  resonance      0.4
  envmod         0.25
  decay          300 ms
  accent         0.7
  slide          60 ms
  drive          0.15
  volume         1.5

patch "Bare Square" family=filter  note=36 range=31..58
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A square through the highpass with some resonance: hollow and boxy, with
  # a bump where the filter sits.
  filter         #2
  wave           #1
  pw             0.5
  cutoff         100 Hz
  resonance      0.6
  envmod         0.2
  decay          400 ms
  accent         0.6
  slide          60 ms
  drive          0.2
  volume         1.1

patch Pinch family=filter  note=36 range=31..58
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Pinch"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  -0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # The envelope throws the highpass up, so each note starts thin and fills
  # in as it falls back.
  filter         #2
  cutoff         60 Hz
  resonance      0.3
  envmod         0.3
  decay          220 ms
  accent         0.7
  slide          50 ms
  drive          0.2
  volume         1.5

patch "Notch Fall" family=filter  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # The notch: the envelope drags a hole down through the saw.
  filter         #3
  cutoff         180 Hz
  resonance      0.35
  envmod         0.8
  decay          600 ms
  accent         0.6
  drive          0.2
  volume         0.92

patch "Notch Drift" family=filter  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Rate"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Depth"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #13
  mac3_a1  0.25
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A slow sine moves the notch, running free, so a hole drifts up and down
  # through the saw like a phaser.
  filter         #3
  cutoff         400 Hz
  resonance      0.3
  envmod         0.2
  decay          800 ms
  accent         0.5
  slide          60 ms
  drive          0.15
  lfo_rate       0.3 Hz
  lfo_cut        0.5
  volume         1.08
  insert Chorus
    depth        0.3
    mix          0.25

patch "Notch Wob" family=filter  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Rate"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Depth"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #13
  mac3_a1  0.25
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A triangle on the notch at eighths, running free, on a saw and square
  # mix.
  filter         #3
  mix            0.4
  cutoff         350 Hz
  resonance      0.6
  envmod         0.1
  decay          900 ms
  accent         0.6
  slide          60 ms
  drive          0.25
  lfo_sync       #6
  lfo_shape      #1
  lfo_cut        0.45
  volume         1.5

patch Whistler family=filter  note=60 range=52..76
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # The highpass with the resonance near the top: the peak whistles over a
  # thin line, into a dotted echo.
  filter         #2
  cutoff         300 Hz
  resonance      0.9
  envmod         0.3
  decay          250 ms
  accent         0.7
  slide          70 ms
  drive          0.2
  volume         0.77
  insert Delay
    time         #4
    feedback     0.35
    tone         3000 Hz
    mode         #1
    mix          0.25
  send reverb    0.1
