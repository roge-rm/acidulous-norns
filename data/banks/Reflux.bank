  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Six bits at a low sample rate: the line turns grainy and metallic.
  cutoff         500 Hz
  resonance      0.72
  envmod         0.65
  decay          240 ms
  accent         0.8
  slide          50 ms
  drive          0.35
  volume         0.89
  insert Bitcrusher
    bits         6
    rate         9000 Hz
    tone         7000 Hz
    mix          0.7

patch Shredder family=dirty  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Clean"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  -0.5
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Full drive, then a wavefolder, then a bit crusher. Barely a filter left
  # in it.
  cutoff         600 Hz
  resonance      0.8
  envmod         0.7
  decay          220 ms
  accent         0.9
  slide          45 ms
  drive          0.9
  volume         0.84
