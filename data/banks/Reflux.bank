  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A slow sine moves the band, running free, so the line drifts between
  # vowels. A little chorus after it.
  mode           #1
  cutoff         500 Hz
  resonance      0.85
  envmod         0.2
  decay          800 ms
  accent         0.5
  slide          80 ms
  drive          0.2
  lfo_rate       0.7 Hz
  lfo_cut        0.35
  volume         0.92
  insert Chorus
    depth        0.4
    mix          0.3
  send reverb    0.12

