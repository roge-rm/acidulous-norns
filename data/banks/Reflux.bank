patch "Random Steps" family=wobble  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Rate"
  set macro4 "Depth"
  set macro5 "Bite"
  set macro6 "Sub"
  set macro7 "Blend"
  set macro8 "Glide"
