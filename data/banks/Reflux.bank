patch "Hollow Pulse" family=sub  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Width"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.2
  mac1_d2  #3
  mac1_a2  0.1
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #9
  mac5_a1  -0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # The pulse squeezed almost shut. A narrow pulse is all odd harmonics and
  # no body, which the filter then has almost nothing to take away from: it
  # is nasal where everything above it is round, and it is a width the
  # machine this descends from could not set.
  wave           #1
  pw             0.08
  cutoff         700 Hz
  resonance      0.55
  envmod         0.5
  decay          220 ms
  accent         0.6
  slide          55 ms
  drive          0.12
  volume         1.06

# Stops at 45: above that the cutoff at the floor leaves the sub with the
# note only thirteen decibels behind it, and it is a sub no longer.
patch "Sub Drop" family=sub  note=36 range=24..45
  set macro1 "Edge"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Width"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.3
  mac1_d2  #2
  mac1_a2  0.2
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #9
  mac5_a1  -0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # All sub and no edge: the cutoff is at the floor, so what is left is the
  # octave below the note and almost nothing else. For the bottom of a mix
  # rather than the front of one.
  wave           #1
  pw             0.5
  sub            1
  cutoff         70 Hz
  resonance      0.2
  envmod         0.1
  decay          900 ms
  accent         0.3
  drive          0.0
  volume         1.46

patch "Thin Ice" family=sub  note=48 range=36..67
  set macro1 "Open"
  set macro2 "Body"
  set macro3 "Snap"
  set macro4 "Bite"
  set macro5 "Width"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.2
  mac1_d2  #3
  mac1_a2  0.1
  mac2_d1  #10
  mac2_a1  0.4
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #9
  mac5_a1  -0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Right at the top of the resonance with almost no envelope: it whistles on
  # the note rather than under it. The one that shows resonance is a tone.
  cutoff         1400 Hz
  resonance      0.97
  envmod         0.15
  decay          220 ms
  accent         0.4
  drive          0.05
  volume         0.76

