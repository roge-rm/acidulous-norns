  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A sine on the cutoff over one bar, running free, with a little sub: the
  # line breathes in and out across the bar.
  sub            0.2
  cutoff         300 Hz
  resonance      0.65
  envmod         0.35
  decay          400 ms
  accent         0.6
  slide          60 ms
  drive          0.12
  lfo_sync       #14
  lfo_cut        0.35
  volume         0.92

patch "Pulse Sweep" family=motion  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Depth"
  set macro8 "Glide"
