patch Siren family=motion  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Longer than Long Sweep by half again, with the resonance up: the filter
  # takes nearly three seconds to travel and the line underneath it is
  # almost beside the point. Hold the pattern and listen to the sweep.
  cutoff         85 Hz
  resonance      0.9
  envmod         1
  decay          2600 ms
  accent         0.35
  slide          80 ms
  drive          0.14
  volume         0.93

patch Wander family=motion  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Depth"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A slow random LFO on the cutoff, and a little on the pitch: the line
  # wanders and never plays a bar the same way twice.
  cutoff         380 Hz
  resonance      0.7
  envmod         0.55
  decay          300 ms
  accent         0.65
  slide          90 ms
  drive          0.12
  lfo_rate       0.7 Hz
  lfo_shape      #4
  lfo_cut        0.35
  lfo_pitch      0.008
  volume         0.89

patch "Octave Down" family=motion  note=48 range=36..60
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Body"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  -0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # The tuning control put a whole octave down with the sub underneath it.
  # Play it where a lead would sit and it answers an octave and a half below
  # your hand, which is a thing a bass with one oscillator cannot do.
  tune           -12 st
  sub            0.55
  cutoff         300 Hz
  resonance      0.5
  envmod         0.45
  decay          420 ms
  accent         0.5
  slide          60 ms
  drive          0.1
  volume         1.06

