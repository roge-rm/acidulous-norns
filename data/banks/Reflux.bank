patch Rasp family=dirty  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Clean"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  -0.5
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Mid-range, half driven, resonance only half up: the filter is shaping
  # distortion rather than the other way round. Sits where a guitar would.
  cutoff         1100 Hz
  resonance      0.5
  envmod         0.3
  decay          200 ms
  accent         0.6
  slide          45 ms
  drive          0.7
  volume         0.92

patch Wasp family=dirty  note=48 range=36..67
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Drive"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
