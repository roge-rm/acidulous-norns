  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A triangle on the cutoff over four bars, with the resonance high: the
  # filter rolls in and out like a tide.
  cutoff         220 Hz
