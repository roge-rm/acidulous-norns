patch Snarl family=wobble  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Rate"
  set macro4 "Depth"
  set macro5 "Bite"
  set macro6 "Sub"
  set macro7 "Blend"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #13
