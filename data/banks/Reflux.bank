patch Screamer family=dirty  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Clean"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  -0.5
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Drive at the top with the resonance still up, which the original could
  # only do by putting a pedal after it. The filter is still doing its job
  # underneath; what comes out the other side is not clean and is not meant
  # to be.
  cutoff         620 Hz
  resonance      0.8
  envmod         0.75
  decay          240 ms
  accent         0.8
  slide          45 ms
  drive          1
  volume         0.87

patch Buzzsaw family=dirty  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Grit"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.2
  mac2_d1  #2
  mac2_a1  0.5
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.15
  mac4_d2  #1
  mac4_a2  -0.1
  mac5_d1  #10
  mac5_a1  0.6
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Filter nearly out of the way and the drive doing the work. Not acid at
  # all - the machine's other end, and the reason drive is in the voice
  # rather than in an insert.
  cutoff         3200 Hz
  resonance      0.25
  envmod         0.25
  decay          400 ms
  accent         0.55
  drive          0.85
  volume         0.91

patch Grind family=dirty  note=36 range=24..48
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Clean"
  set macro5 "Body"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  -0.5
  mac5_d1  #10
  mac5_a1  -0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Sub most of the way up, cutoff low, drive high. The distortion is working
  # on the octave below the note rather than on the note, which is what makes
  # it a texture instead of a fuzz pedal.
  # 0.4 rather than 0.8: at 0.8 the octave below was eighteen decibels
  # ahead of the note, so you played one note and heard another.
  sub            0.4
  cutoff         190 Hz
  resonance      0.4
  envmod         0.35
  decay          600 ms
  accent         0.6
  drive          0.9
  volume         0.98

patch Foldback family=dirty  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Drive"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A wavefolder after the filter: as the envelope opens, the wave folds
  # back on itself and new harmonics come in from the top.
  cutoff         300 Hz
  resonance      0.6
  envmod         0.8
  decay          280 ms
  accent         0.8
  slide          50 ms
  drive          0.3
  volume         0.79
  insert Distortion
    drive        3
    tone         6000 Hz
    mix          0.7
    mode         #2

patch "Low Bits" family=dirty  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Snap"
  set macro4 "Drive"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
