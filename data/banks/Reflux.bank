  volume         1.44

patch "Band Glide" family=band  note=48 range=43..67
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
