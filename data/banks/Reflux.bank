  cutoff         500 Hz
  resonance      0.55
  envmod         0.5
  decay          350 ms
  accent         0.6
  slide          60 ms
  drive          0.1
  lfo_sync       #15
  lfo_shape      #1
  lfo_pw         0.9
  volume         0.76

patch Ebb family=motion  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
