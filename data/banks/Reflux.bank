patch Tick family=short  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Length"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  0.3
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # The shortest thing the envelope can do: forty milliseconds, all of it
  # thrown at the filter. Each step is a click with a pitch rather than a
  # note with a filter on it, and a line of them is closer to a hi-hat
  # pattern than to a bass part.
  cutoff         250 Hz
  resonance      0.8
  envmod         1
  decay          45 ms
  accent         0.85
  slide          20 ms
  drive          0.18
  volume         0.92

patch "Dotted Pluck" family=short  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Length"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  0.3
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A short pluck into a dotted eighth ping-pong, so the echoes fill the gaps.
  cutoff         1200 Hz
  resonance      0.3
  envmod         0.6
  decay          100 ms
  accent         0.6
  slide          25 ms
  drive          0.2
  volume         0.83
  insert Delay
    time         #3
    feedback     0.4
    tone         4000 Hz
    mode         #1
    mix          0.3
  send reverb    0.12

patch Knock family=short  note=36 range=30..55
  set macro1 "Thin"
  set macro2 "Squelch"
  set macro3 "Length"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  0.3
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.4
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # The highpass, resonant just above the note: a hollow knock with no
  # bottom. Below 30 the fundamental is under the cutoff.
  filter         #2
  cutoff         120 Hz
  resonance      0.6
  envmod         0.6
  decay          70 ms
  accent         0.7
  slide          20 ms
  drive          0.15
  volume         1.5

# Same again, higher: a band at 2600 Hz has nothing to say about a note at
# 100.
patch Glass family=short  note=60 range=49..79
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Length"
  set macro4 "Bite"
  set macro5 "Ring"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac1_d2  #3
  mac1_a2  0.15
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #4
  mac3_a1  0.3
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #4
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Band-pass with the resonance at the very top and almost no envelope:
  # the filter rings on its own and the oscillator is only there to start it.
  # Played high it is a ping rather than a bass at all.
  mode           #1
  cutoff         2600 Hz
  resonance      0.99
  envmod         0.08
  decay          260 ms
  accent         0.3
  slide          35 ms
  drive          0.05
  volume         0.62

patch Rattle family=short  note=36 range=24..55
