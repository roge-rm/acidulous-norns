  mac6_a1  0.3
  mac7_d1  #11
  mac7_a1  1
  mac8_d1  #6
  mac8_a1  0.3
  # A saw at eighth note triplets on the cutoff and the pulse width, with
  # both waves and the drive up. The wobble talks.
  mix            0.5
  pw             0.4
  cutoff         280 Hz
  resonance      0.75
  envmod         0.2
  decay          900 ms
  accent         0.6
  sub            0.25
  drive          0.6
