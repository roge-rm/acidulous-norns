    rate         7000 Hz
    jitter       0.3
    tone         6000 Hz
    mix          0.5

# --- motion ------------------------------------------------------------

patch Talk family=motion  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Envelope all the way up on a middling cutoff, so each note starts bright
  # and closes to a vowel. The most speech-like thing a one-pole-per-stage
  # ladder can do, and the reason people say these lines sing.
  cutoff         620 Hz
  resonance      0.6
  envmod         1
  decay          340 ms
  accent         0.7
  slide          70 ms
  drive          0.1
  volume         0.85

patch "Snap Back" family=motion  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # All of the envelope and a very short decay, with long slides: each note
  # flicks open and the pitch drags into the next.
  cutoff         200 Hz
  resonance      0.75
  envmod         1
  decay          110 ms
  accent         0.8
  slide          180 ms
  drive          0.15
  volume         0.92

patch "Wah Line" family=motion  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
