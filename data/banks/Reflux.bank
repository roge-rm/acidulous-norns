patch Warble family=wobble  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Rate"
  set macro4 "Depth"
  set macro5 "Bite"
  set macro6 "Sub"
  set macro7 "Blend"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #13
  mac3_a1  0.25
  mac4_d1  #15
  mac4_a1  0.02
  mac5_d1  #7
  mac5_a1  0.4
  mac6_d1  #10
  mac6_a1  0.3
  mac7_d1  #11
  mac7_a1  1
  mac8_d1  #6
  mac8_a1  0.3
  # A sine on the pitch at eighth notes, restarting on each note, and a
  # little on the cutoff: the note wavers like a worn tape.
  cutoff         420 Hz
  resonance      0.5
  envmod         0.3
  decay          800 ms
  accent         0.5
  sub            0.2
  drive          0.2
  lfo_sync       #6
  lfo_retrig     #1
  lfo_pitch      0.02
  lfo_cut        0.15
  volume         1.16
  insert Chorus
    depth        0.4
    mix          0.3

patch Trill family=wobble  note=36 range=24..55
  set macro1 "Open"
