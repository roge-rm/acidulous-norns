  mac3_d1  #4
  mac3_a1  -0.3
  mac3_d2  #5
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.5
  mac5_d1  #10
  mac5_a1  0.6
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  -0.4
  # Every note glides into the next. The slide is the other half of what
  # this machine is for and nothing else here is built around it: at half a
  # second the line stops being notes and becomes one moving pitch.
  cutoff         380 Hz
  resonance      0.68
  envmod         0.6
  decay          260 ms
  accent         0.7
  slide          420 ms
  drive          0.14
  volume         0.89

patch "Long Glide" family=motion  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A square through the 12 dB lowpass with a quarter second of slide on
  # every legato note.
  wave           #1
  pw             0.45
  filter         #1
  cutoff         350 Hz
  resonance      0.6
  envmod         0.55
  decay          350 ms
  accent         0.6
  slide          250 ms
  drive          0.1
  volume         0.65

patch "Glide Echo" family=motion  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A sliding line into a quarter note delay, so the slides echo across the
  # beat.
  cutoff         420 Hz
  resonance      0.7
  envmod         0.6
  decay          300 ms
  accent         0.7
  slide          200 ms
  drive          0.15
  volume         0.81
  insert Delay
    time         #4
    feedback     0.35
    tone         3000 Hz
    mode         #1
    mix          0.25
  send reverb    0.1

patch "Long Sweep" family=motion  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # A decay far longer than a step, so the filter never closes and the line
  # rises across the bar instead of inside each note.
  cutoff         180 Hz
  resonance      0.72
  envmod         0.95
  decay          1600 ms
  accent         0.45
  slide          60 ms
  drive          0.15
  volume         0.91

patch Crawl family=motion  note=24 range=24..48
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Low, slow, and sliding most of the way: the line that moves underneath
  # everything else rather than driving it. A long decay on a low cutoff
  # means the filter is still opening when the bar ends.
  cutoff         120 Hz
  resonance      0.7
  envmod         0.85
  decay          1100 ms
  accent         0.4
  slide          300 ms
  drive          0.12
  volume         1.32

patch Breather family=motion  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Depth"
  set macro8 "Glide"
