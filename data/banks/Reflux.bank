  lfo_shape      #3
  lfo_retrig     #1
  lfo_cut        0.6
  lfo_pw         0.5
  volume         0.89
  insert Distortion
    drive        3
    tone         5000 Hz
    mix          0.4
    mode         #3

# --- band --------------------------------------------------------------

patch "Band Squelch" family=band  note=36 range=24..55
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Band-pass: no bottom and no top, so what is left is the resonance itself.
  # Volume at the top and drive doing the rest, and it is still the quietest
  # thing here by two decibels - which is what taking the ends off a spectrum
  # costs, not something to pretend away.
  mode           #1
  cutoff         690 Hz
  resonance      0.85
  envmod         0.8
  decay          120 ms
  accent         0.9
  drive          0.55
  volume         1.50

patch "Band Pluck" family=band  note=48 range=43..67
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
  # Macros: each knob adds its depth to the destinations below.
  mac1_d1  #1
  mac1_a1  0.25
  mac2_d1  #2
  mac2_a1  0.3
  mac3_d1  #3
  mac3_a1  0.3
  mac3_d2  #4
  mac3_a2  0.2
  mac4_d1  #7
  mac4_a1  0.4
  mac5_d1  #10
  mac5_a1  0.3
  mac6_d1  #11
  mac6_a1  1
  mac7_d1  #14
  mac7_a1  0.3
  mac8_d1  #6
  mac8_a1  0.3
  # Band-pass with a short decay: a hollow click of a note with the band
  # sitting a few harmonics up.
  mode           #1
  cutoff         420 Hz
  resonance      0.7
  envmod         0.5
  decay          140 ms
  accent         0.8
  slide          40 ms
  drive          0.3
  volume         1.46

patch Nasal family=band  note=48 range=43..67
  set macro1 "Open"
  set macro2 "Squelch"
  set macro3 "Sweep"
  set macro4 "Bite"
  set macro5 "Sub"
  set macro6 "Blend"
  set macro7 "Wobble"
  set macro8 "Glide"
