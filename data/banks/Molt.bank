patch Glide family=play
  # Between notes rather than at them, so a written melody is sung as one
  # line. Under a chord this is what makes four voices move together.
  glide          0.3 s
  tune           0.9
  rate           30 ms
  volume         0.2397
  set macro1 "Octave Down"
  mac1_d1  #16
  mac1_a1  -0.5
  mac1_d2  #14
  mac1_a2  -0.0273
  set macro2 "Fifth Up"
  mac2_d1  #16
  mac2_a1  0.292
  set macro3 "Later"
  mac3_d1  #1
  mac3_a1  0.3
  mac3_d2  #14
  mac3_a2  0.0547
  set macro4 "Looser"
  mac4_d1  #2
  mac4_a1  -0.5
  mac4_d2  #14
  mac4_a2  -0.0195
  set macro5 "Bigger"
  mac5_d1  #4
  mac5_a1  -0.2
  set macro6 "Darker"
  mac6_d1  #6
  mac6_a1  -0.25
  set macro7 "Grit"
  mac7_d1  #13
  mac7_a1  0.5
  mac7_d2  #14
  mac7_a2  -0.0801
  set macro8 "Longer"
  mac8_d1  #11
  mac8_a1  0.3

patch "Octave Down" family=play
  # An octave below what is written, at the original size. Pitch and formant
  # separated, stated as plainly as the machine can state it.
  octave         #2
  formant        +4 st
  volume         0.2083
  set macro1 "Octave Up"
  mac1_d1  #16
  mac1_a1  0.5
  set macro2 "Fifth Up"
  mac2_d1  #16
  mac2_a1  0.292
  mac2_d2  #14
