patch "Wide Bend" family=play
  # An octave of bend, for a line that is played rather than typed. The tune
  # is left short of one so the bend has the voice's own line to move.
  bendrange      #12
  tune           0.85
  rate           50 ms
  volume         0.2401
  set macro1 "Octave Down"
  mac1_d1  #16
  mac1_a1  -0.5
