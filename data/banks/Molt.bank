  set macro4 "Looser"
  mac4_d1  #2
  mac4_a1  -0.5
  set macro5 "Bigger"
  mac5_d1  #4
  mac5_a1  -0.2
  set macro6 "Darker"
  mac6_d1  #6
  mac6_a1  -0.25
  mac6_d2  #14
  mac6_a2  0.0188
  set macro7 "Grit"
  mac7_d1  #13
