  mac4_a2  0.0312
  set macro5 "Jump"
  mac5_d1  #5
  mac5_a1  1.0
  mac5_d2  #15
  mac5_a2  -0.0312
  set macro6 "Chaos"
  mac6_d1  #1
  mac6_a1  0.5
  mac6_d2  #3
  mac6_a2  0.4
  mac6_d3  #5
  mac6_a3  0.4
  mac6_d4  #15
  mac6_a4  -0.0312
  set macro7 "Rolls"
